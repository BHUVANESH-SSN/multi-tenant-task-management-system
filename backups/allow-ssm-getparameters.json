{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSSMGetParametersForCopilot",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:eu-north-1:604475637823:parameter/copilot/multi-tenant-system/production/secrets/DATABASE_URL",
        "arn:aws:ssm:eu-north-1:604475637823:parameter/copilot/*"
      ]
    },
    {
      "Sid": "AllowKmsDecryptIfNeeded",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*"
    }
  ]
}